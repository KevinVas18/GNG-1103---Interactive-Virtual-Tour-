  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "This setup is a refrigeration and heat-pump training rig, a hands-on teaching
    unit used in engineering and HVAC labs to demonstrate how the vapor-compression
    refrigeration cycle works. The system includes a compressor, condenser coil,
    evaporator coil, expansion device, copper piping, pressure gauges, thermocouples,
    and an electrical control panel with meters for monitoring temperature, voltage,
    current, and system behavior. Students use this equipment to observe refrigerant
    flow, measure high- and low-side pressures, analyze superheating and subcooling,
    and calculate the system\u2019s efficiency and coefficient of performance. Essentially,
    it\u2019s a full working refrigerator/AC system designed for education and experimentation.\n\n  
    Press the Button again in order to exit. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
